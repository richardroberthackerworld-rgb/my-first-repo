{
  "name": "7audio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "7 Audio — AI Audio Toolkit. Audio tools, perfected.",
  "scripts": {
    "dev": "vite --port 3190",
    "build": "node scripts/sync-ffmpeg-core.mjs && node scripts/make-sitemap.mjs && tsc -b && vite build && node scripts/prerender.mjs && node scripts/make-sw.mjs",
    "preview": "vite preview --port 3190",
    "sync:ffmpeg": "node scripts/sync-ffmpeg-core.mjs",
    "typecheck": "tsc -b --noEmit",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
