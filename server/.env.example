# ---- Copy this file to ".env" and fill in your real values ----

# Server
PORT=8787
# Comma-separated list of allowed origins — every site that calls this API.
#
# NO TRAILING SLASHES. A browser sends "https://7audio.7by.in", never
# "https://7audio.7by.in/", so a trailing slash here silently blocks the site.
# (The server strips them anyway, but other tools will not.)
#
# Include the local dev ports if you develop against the live API.
# Use * only for local testing, never in production.
CORS_ORIGIN=https://7audio.7by.in,https://7by.in,https://account.7by.in,http://localhost:3190,http://localhost:3191

# JWT signing secret — set to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# ---- Email (OTP) — SMTP for noreply@7by.in ----
# If these are left blank, OTPs are printed to the server console (dev mode) instead of emailed.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@7by.in
SMTP_PASS=your-smtp-password
MAIL_FROM=7By.in <noreply@7by.in>
SUPPORT_EMAIL=contact@7by.in
# Public URL of your logo shown in emails (upload your PNG to this path)
LOGO_URL=https://7by.in/assets/favicon.png

# ---- Google Sign-In ----
# Create an OAuth 2.0 Client ID (Web) in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret (Razorpay Dashboard → Settings → Webhooks). Point the webhook at
# https://api.7by.in/api/pay/webhook and subscribe to "payment.captured".
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Credit plans (credits granted per successful payment)
PLAN_MONTHLY_AMOUNT=2700
PLAN_MONTHLY_CREDITS=1000
PLAN_ANNUAL_AMOUNT=29900
PLAN_ANNUAL_CREDITS=20000

# ---- Cashfree Payments (7 Audio) ----
# Dashboard -> Developers -> API Keys. NEVER commit real values.
# CASHFREE_ENV must be the literal string "production" to charge real money;
# anything else (including blank) stays on sandbox.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
# Dashboard -> Developers -> Webhooks. Point it at:
#   https://api.7by.in/api/pay/cashfree/webhook
# Subscribe to PAYMENT_SUCCESS_WEBHOOK (and failure events if you want them logged).
# If left blank the secret key is used, which matches Cashfree default behaviour.
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
# Where Cashfree sends the customer back after checkout.
CASHFREE_RETURN_URL=https://7audio.7by.in/credits?order={order_id}

# ============================================================================
# 7 AUDIO — TRANSACTIONAL EMAIL
#
# Four sender identities, all on the same domain. Set the mailbox credentials
# once; audio-mail.js selects the right From address per email type.
#
#   noreply@7audio.7by.in    verification codes
#   welcome@7audio.7by.in    account created
#   thankyou@7audio.7by.in   payment outcome
#   contact@7audio.7by.in    replies from customers
#
# NOTHING HERE IS READABLE FROM THE BROWSER. These are server variables only —
# never copy any of them into a VITE_ / NEXT_PUBLIC_ variable.
# ============================================================================

# The mail domain the four senders live on.
AUDIO_MAIL_DOMAIN=7audio.7by.in

# SMTP for the 7 Audio mailbox. If these are blank the server falls back to the
# SMTP_* values above; if BOTH are blank, emails are logged instead of sent and
# the log records them as "not-configured" rather than pretending they went.
AUDIO_SMTP_HOST=smtp.your-provider.com
AUDIO_SMTP_PORT=587
AUDIO_SMTP_USER=noreply@7audio.7by.in
AUDIO_SMTP_PASS=your-mailbox-password

# Links inside the emails. Set these to the live site or every button in every
# email points at the wrong place.
AUDIO_SITE_URL=https://7audio.7by.in
AUDIO_PRICING_URL=https://7audio.7by.in/pricing
AUDIO_DASHBOARD_URL=https://7audio.7by.in/dashboard
# Must be a PUBLIC url — mail clients cannot load a local file.
AUDIO_LOGO_URL=https://7audio.7by.in/brand/icon-192.png
