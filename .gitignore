# Built deployment artifacts (rebuilt by make-zips.ps1) — may contain live API keys, never commit
*.zip
*.tar.gz

# SERVER-SIDE API KEYS — never commit. Only keys.example.php belongs in git.
keys.php
*/keys.php

# Local tooling state
.gstack/
.claude/settings.local.json

# Node
node_modules/

# build output for the videotools subdomain packages
dist/
*.tar.gz
video-subdomain*.zip
main-site-addons*.zip

# Android signing keys — NEVER commit (anyone with these can sign fake app updates)
android/*.keystore
android/*.jks
android/**/app-release-*.aab
android/**/app-release-*.apk
android/**/build/

# Built app bundles (rebuildable; keep out of the public repo)
android/**/*.aab
# Gradle build caches
android/**/.gradle/
android/**/build/

# 7Compare server secrets — Telegram bot token, affiliate API keys, admin key.
# Only secrets.example.json belongs in git.
7compare/server/secrets.json
**/server/secrets.json

# 7Compare runtime cache — scraped prices, push subscriptions, the broadcast
# ledger. Regenerated by the engine; nothing here should ever be published.
7compare/server/cache/

# 7Marks credit ledger — per-user transaction data, never commit
7marks/.ledger/*.json

# 7Marks database credentials — never commit
7marks/db/config.php

# Runtime data written by the apps at their default paths — contact messages,
# the ops/quality logs the admin dashboard reads, sync state. Real user content
# and none of it belongs in git. .htaccess also 404s these directories.
*/data/

# negative-control.js sidecar: originals held while a checker is cut out.
# Transient by design; a committed one would mean a run was killed.
7solve/.negative-control-restore.json
