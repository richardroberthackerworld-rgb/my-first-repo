# 7Solve — security + clean URLs

# ---- protect the server-side key file ----
# api.php is the only thing the browser may call; keys*.php must never be fetched.
<FilesMatch "^keys.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Belt and braces: if PHP ever stops executing (misconfig), never serve these as plain text.
<FilesMatch "\.(php|inc)$">
    <IfModule mod_php.c>
        php_flag engine on
    </IfModule>
</FilesMatch>

# Block hidden/system files (.git, .env, backups) but ALLOW /.well-known/
# which Android needs to verify the Play Store app owns this domain.
RedirectMatch 404 /\.(?!well-known)
<FilesMatch "\.(log|bak|old|sql|zip|env|jsonl|ndjson)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Contact-form messages land in ./data as JSONL when contact_dir is left at its
# default. Under the web root that is fetchable, which would hand out every
# sender's email — so the whole directory is closed. Setting contact_dir to a
# path outside public_html is still the better answer.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/data(/|$)
</IfModule>

# Don't list folder contents
Options -Indexes
ServerSignature Off

# ---- security headers ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=(self)"
    # Protects against tab-nabbing but still ALLOWS popups, which Google
    # Sign-In and the Razorpay checkout both need ("same-origin" would break them).
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    # NOTE: screenshots and screen recording are deliberately NOT blocked —
    # students are encouraged to save and share their answers.
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ---- clean URLs: no .html, no /index.html in the address bar ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # /index.html  ->  /        and  /page.html  ->  /page   (visible redirect)
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+(.*)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # ---- public API ----
    # /v1/<route> -> v1.php?route=<route>. This sits ABOVE the clean-URL and
    # app-route rules on purpose: those end in [L] and would otherwise claim
    # the path first. The route is passed as a query parameter rather than
    # parsed from REQUEST_URI so that a rewrite that is switched off fails as
    # a plain 404 instead of silently serving an unrouted page.
    #
    # Authorization is forwarded explicitly: CGI/FastCGI strips that header,
    # which would leave every authenticated call looking like an anonymous one.
    # The Authorization capture MUST come first: the routing rule below ends in
    # [L], so anything placed after it would never execute at all.
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^v1/ - [E=HTTP_AUTHORIZATION:%1]
    RewriteRule ^v1/([a-z]+(?:/[A-Za-z0-9_]+)?)/?$ v1.php?route=$1 [QSA,L]

    # serve the real .html file for a clean URL (address bar keeps the clean form)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # ---- app routes ----
    # The application is one page with an in-browser router, so /tutor,
    # /pricing and the rest have no file behind them. They are listed by name
    # rather than caught with a blanket fallback, so a genuine typo still 404s
    # instead of silently returning the app, and /blog/, api.php and every real
    # asset are untouched (they matched -f or -d above and never reach here).
    RewriteRule ^(home|ask|answer|notebook|levels|tutor|subjects|practice|flashcards|mindmaps|planner|tools|docs|affairs|community|progress|rewards|bookmarks|settings|pricing|credits|profile|contact|mistakes|learning|chapter)/?$ index.html [L]
    # practice sub-routes: /practice/notes, /practice/doubts, /practice/mistakes
    RewriteRule ^practice/(notes|doubts|mistakes)/?$ index.html [L]
</IfModule>

# The Play Store app verifies domain ownership by reading this file, which
# must be public and served as JSON.
<Files "assetlinks.json">
    <IfModule mod_headers.c>
        Header set Content-Type "application/json"
    </IfModule>
</Files>

# Docs/readmes should not be browsable
<FilesMatch "\.(md|markdown)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ---- caching ----
# The whole app is one index.html, so a stale copy means a stale product.
# These three must always be revalidated, or a new upload can sit invisible
# behind the browser cache (and the service worker, which caches whatever
# the network hands it) for as long as the heuristic freshness lasts.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js|manifest\.json|config\.js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Fingerprinted or rarely-changing assets can be held for a year. They are
    # all requested with a ?v= query, so a change to one is a new URL.
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
